# ============================================================
# VoxeraMeta v4.1 — Render Environment Variables
# ============================================================

PORT=3000
NODE_ENV=production

# Android ↔ Backend güvenlik tokeni
API_AUTH_TOKEN=BURAYA_KENDI_TOKENINI_KOY

# ── LYRICS PROVIDERLARI ───────────────────────────────────────
GROQ_API_KEY=gsk_BURAYA_KOY
OPENROUTER_API_KEY=sk-or-v1-BURAYA_KOY
GEMINI_API_KEY=AIzaSy_BURAYA_KOY

# ── COLAB WORKER ──────────────────────────────────────────────
# COLAB_SECRET: Colab ve Render'da AYNI değer olmalı
# Kendin belirle: örn. "mysecret123"
COLAB_SECRET=BURAYA_KOY

# COLAB_URL: Colab başladığında OTOMATIK güncellenir (elle yazma)
# Sadece Colab çalışmıyorken override için kullanılabilir:
# COLAB_URL=https://xxxx.ngrok-free.app/process
COLAB_URL=

# ── SUNUCU ───────────────────────────────────────────────────
# BASE_URL: Render'daki servis URL'in (ses dosyası linkleri için)
BASE_URL=https://SENIN-APP-ADIN.onrender.com
LOCAL_STORAGE_PATH=/tmp/voxerameta-songs
MAX_REQUESTS_PER_MINUTE=30
# BASE_URL: Render servis URL'in — ses dosyası linkleri için KRİTİK
# Render Dashboard → Settings → "onrender.com" URL'ini buraya yaz
BASE_URL=https://voxerameta-ai-backend.onrender.com
# Render ayrıca RENDER_EXTERNAL_URL'i otomatik set eder — BASE_URL yoksa o kullanılır
