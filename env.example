# ═══════════════════════════════════════════════════
# VoxeraMeta Backend — Ortam Değişkenleri
# Yerelde: bu dosyayı .env olarak kopyalayın.  Render'da: Dashboard → Environment
# ═══════════════════════════════════════════════════

PORT=3000
NODE_ENV=production

# ZORUNLU — Colab ↔ Render kimlik doğrulaması. En az 16 karakter, tahmin edilmesi zor olsun.
# (Colab notebook'taki COLAB_SECRET ile AYNI olmalı)
#   üretmek için:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
COLAB_SECRET=

# Backend'in kendi genel adresi (Render genelde RENDER_EXTERNAL_URL'i kendisi ayarlar)
# BASE_URL=https://voxerameta-ai-backend.onrender.com

# Sözler: preserve (varsayılan) = sözleriniz aynen kalır, sadece [Verse]/[Chorus] etiketleri eklenir
#         rewrite             = LLM sözleri şarkıya uyarlar (aşağıdaki anahtarlardan en az biri gerekir)
LYRICS_MODE=preserve
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# İsteğe bağlı: uygulamadan gelen isteklerde X-Auth-Token zorunlu olsun (APK'dan okunabilir, gerçek güvenlik değildir)
# API_AUTH_TOKEN=

# Depolama (Render ücretsiz planda /tmp her yeniden başlamada silinir)
LOCAL_STORAGE_PATH=/tmp/voxerameta-songs

# Sınırlar
MAX_REQUESTS_PER_MINUTE=30
# MAX_SONG_SECONDS=180
# JOB_MAX_ATTEMPTS=3
# JOB_TIMEOUT_SECONDS=720
# PENDING_TIMEOUT_SECONDS=1800
# COLAB_ALIVE_SECONDS=360
