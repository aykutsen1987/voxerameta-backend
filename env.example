# ============================================================
# VoxeraMeta v3.0 — Render Ortam Değişkenleri
# cp .env.example .env  →  değerleri doldur
# ============================================================

PORT=3000
NODE_ENV=production

# ── LYRICS PROVIDERLARI (en az biri gerekli) ─────────────────

# 1. Groq — ZORUNLU (ana lyrics provider, Render'da çalışır)
# Kayıt: https://console.groq.com → API Keys
# Kredi kartı GEREKMİYOR | Limit: 1.000 istek/gün
GROQ_API_KEY=gsk_BURAYA_KOY

# 2. OpenRouter — opsiyonel fallback (Render'da çalışır)
# Kayıt: https://openrouter.ai → API Keys
# Limit: 200 istek/gün (:free modeller)
OPENROUTER_API_KEY=sk-or-v1-BURAYA_KOY

# 3. Google Gemini 2.5 Flash — opsiyonel fallback (Render'da çalışır)
# Kayıt: https://aistudio.google.com → Get API Key
# Limit: 500 istek/gün
# NOT: Bu API YALNIZCA Render backend'de kullanılır. Colab'da çalışmaz.
GEMINI_API_KEY=AIzaSy_BURAYA_KOY

# ── MÜZİK PROVIDERLARI ───────────────────────────────────────

# 1. Colab MusicGen + RVC — ANA PROVIDER
# ÖNEMLİ: URL sonuna /generate-music veya /generate-song EKLEME!
# Sadece ngrok base URL'sini girin.
#
# Adımlar:
#   a) colab/voxera_rvc_tek_hucre.ipynb dosyasını Google Colab'da aç
#   b) Runtime > Run all → son satırda ngrok URL'si görünür
#   c) URL'yi buraya yapıştır (her Colab oturumunda değişir!)
#
# Doğru format:  https://abc123.ngrok-free.app
# Yanlış format: https://abc123.ngrok-free.app/generate-music  ← suffix ekleme!
COLAB_MUSIC_API_URL=https://BURAYA_NGROK_BASE_URL

# 2. Local Self-Host — gelecek (şu an boş bırak)
LOCAL_MUSIC_API_URL=

# 3. Replicate — opsiyonel fallback
# Kayıt: https://replicate.com → API Tokens
REPLICATE_API_TOKEN=

# ── RENDER SUNUCU AYARLARI ────────────────────────────────────

# Render'ın dış adresi — ses dosyası URL'leri için zorunlu
# Render Dashboard → Settings → Custom Domains veya onrender.com adresi
BASE_URL=https://SENIN-APP-ADIN.onrender.com

LOCAL_STORAGE_PATH=/tmp/voxerameta-songs
MAX_REQUESTS_PER_MINUTE=20

# ── GÜVENLİK (opsiyonel) ─────────────────────────────────────
# Boş bırakılırsa API herkese açık (geliştirme için uygundur)
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_AUTH_TOKEN=
