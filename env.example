# ═══════════════════════════════════════════════════
# VoxeraMeta Backend — Ortam Değişkenleri
# Render Dashboard → Environment bölümüne ekleyin
# ═══════════════════════════════════════════════════

# ── Zorunlu ─────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Colab ↔ Render kimlik doğrulama (her ikisinde de aynı olmalı)
COLAB_SECRET=gizli_bir_sifre_buraya

# Backend'in kendi URL'i (Render otomatik set eder — genellikle boş bırakın)
# BASE_URL=https://voxerameta-ai-backend.onrender.com

# ── Şarkı Sözü AI (en az biri zorunlu) ─────────────
GROQ_API_KEY=gsk_...          # https://console.groq.com → ücretsiz
# OPENROUTER_API_KEY=sk-or-...  # https://openrouter.ai → ücretsiz tier
# GEMINI_API_KEY=AIza...        # https://aistudio.google.com → ücretsiz

# ── Müzik Üretimi (Colab Pipeline — zorunlu) ────────
# COLAB_URL → /api/colab/register ile otomatik güncellenir, elle ayarlanmasına gerek yok

# ── Opsiyonel Müzik Provider'ları ───────────────────
# REPLICATE_API_TOKEN=r8_...    # https://replicate.com → ücretsiz tier
# HUGGINGFACE_API_KEY=hf_...    # https://huggingface.co/settings/tokens → ücretsiz

# ── Senaryo 2: Vokal AI (opsiyonel) ─────────────────
# ELEVENLABS_API_KEY=...         # https://elevenlabs.io → ücretsiz tier
# ELEVENLABS_VOICE_MALE=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
# OPENAI_API_KEY=sk-...          # https://platform.openai.com

# ── Depolama ─────────────────────────────────────────
LOCAL_STORAGE_PATH=/tmp/voxerameta-songs

# ── Rate Limiting ────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=30
